# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Кому разрешено писать боту (id пользователей через запятую; узнать свой id: @userinfobot)
ALLOWED_USER_IDS=123456789

# Прокси для Telegram API. Squid на 3128 принимает обычный HTTP и туннелирует HTTPS
# через CONNECT, поэтому схема http://. "none" — без прокси.
PROXY_URL=http://localhost:3128

# Где запускать claude по умолчанию (меняется командой /cwd)
CLAUDE_WORK_DIR=/home/zilog/dev
CLAUDE_BIN=/home/zilog/.local/bin/claude
# acceptEdits | auto | bypassPermissions | dontAsk | plan
CLAUDE_PERMISSION_MODE=auto
#CLAUDE_MODEL=claude-opus-5-5
#CLAUDE_EXTRA_ARGS=--allowedTools Bash,Read,Edit,Write
# Показывать в чате, какие инструменты запускает Claude
SHOW_TOOLS=true
RUST_LOG=info

# Окружение для самого процесса claude (systemd не наследует переменные твоей оболочки)
HTTPS_PROXY=http://localhost:3128
HTTP_PROXY=http://localhost:3128
PATH=/home/zilog/.local/bin:/usr/local/bin:/usr/bin:/bin
