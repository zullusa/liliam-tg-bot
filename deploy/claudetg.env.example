# Копия этого файла — твой личный конфиг: ~/.config/claudetg/claudetg.env (chmod 600).
# Замени YOU на своё имя пользователя в путях и обязательно поменяй ALLOWED_USER_IDS:
# без своих id бот не отвечает никому. Значений TELEGRAM_BOT_TOKEN отсюда не бывает
# в git: .env и *.env в .gitignore.

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Кому разрешено писать боту (id пользователей через запятую; узнать свой id: @userinfobot).
# ВНИМАНИЕ: это заглушка — с ней бот работает и молчит, игнорируя все сообщения.
ALLOWED_USER_IDS=123456789

# Прокси для Telegram API. Squid на 3128 принимает обычный HTTP и туннелирует HTTPS
# через CONNECT, поэтому схема http://. "none" — без прокси.
PROXY_URL=http://localhost:3128

# Где запускать claude по умолчанию (меняется командой /cwd)
CLAUDE_WORK_DIR=/home/YOU/dev
CLAUDE_BIN=/home/YOU/.local/bin/claude
# acceptEdits | auto | bypassPermissions | dontAsk | plan
CLAUDE_PERMISSION_MODE=auto
#CLAUDE_MODEL=claude-opus-5-5
#CLAUDE_EXTRA_ARGS=--allowedTools Bash,Read,Edit,Write
# Одна живая строка о том, что делает агент (правится на месте, отдельных
# сообщений про каждый инструмент в чате нет). 0 — совсем без строки статуса.
SHOW_TOOLS=true
RUST_LOG=info

# --- Агент (бэкенд) ---
# Кого использовать по умолчанию: claude или opencode. В чате переключается /backend.
CLAUDETG_BACKEND=claude
# opencode ставится в ~/.opencode/bin — systemd PATH его не видит, укажи путь явно.
OPENCODE_BIN=/home/YOU/.opencode/bin/opencode
# Модель в формате provider/model[#variant]. По умолчанию — локальная Strata:
# strata/qwen3.8-flash-next-iq3_s («Qwen3.8-Flash-Next (local)»); none — брать из конфига opencode.
#OPENCODE_MODEL=
# Агент из конфигурации opencode (--agent), если нужен.
#OPENCODE_AGENT=
# 0 — не добавлять --auto (инструменты без явного разрешения будут отклоняться).
OPENCODE_AUTO=1
#OPENCODE_EXTRA_ARGS=

# При лимите Claude передавать контекст opencode, работать им и вернуться
# к claude при сбросе лимита. 0 — только ждать и продолжать ту же сессию.
CLAUDETG_LIMIT_FALLBACK=1
# Где Claude Code хранит сессии (для расшифровки контекста).
#CLAUDE_PROJECTS_DIR=/home/YOU/.claude/projects

# Окружение для самого процесса claude (systemd не наследует переменные твоей оболочки)
HTTPS_PROXY=http://localhost:3128
HTTP_PROXY=http://localhost:3128
PATH=/home/YOU/.local/bin:/home/YOU/.opencode/bin:/usr/local/bin:/usr/bin:/bin

# Агрегация сообщений: части одной задачи складываются в один запуск —
# ждём тишины N секунд, но от первой части не дольше M секунд (0 — запуск сразу).
CLAUDETG_AGG_QUIET_SECS=12
CLAUDETG_AGG_WINDOW_SECS=60

# Исходящая очередь сообщений в чат: `claudetg send` и ответ агента кладутся в
# каталог рядом с состоянием бота, а бот отправляет их пачкой — несколько коротких
# сообщений за один шаг уходят одним сообщением. quiet — тишина после последнего
# сообщения, max — предельный срок от первого, max_items — сколько сообщений
# склеиваем без ожидания тишины.
CLAUDETG_SEND_QUIET_SECS=7
CLAUDETG_SEND_MAX_SECS=25
CLAUDETG_SEND_MAX_ITEMS=4
# Срок годности сообщения в очереди, секунд (0 — очередь без срока). Пока бот
# пережидает лимит Telegram или отсутствие связи, тексты устаревают: то, что
# старше этого срока, в чат не уходит — иначе бот «гонит старые сообщения».
CLAUDETG_SEND_TTL_SECS=1800
# 0 — отправлять и служебные строки вида «выполняю команду» (по умолчанию не отправляем).
CLAUDETG_DROP_CHATTER=1

# Сколько ждать смену агента от прежнего запуска бота (её процесс выживает при
# рестарте сервиса), прежде чем поднять новую. 900 — четверть часа.
CLAUDETG_SHIFT_WAIT_SECS=900

# Адрес Bot API. По умолчанию https://api.telegram.org; свой адрес полезен для
# тестов и самодельных прокси-серверов.
#CLAUDETG_API_BASE=https://api.telegram.org

# Куда скачивать вложения из чата (документы, фото, видео, аудио, голосовые) и
# размерный лимит: Bot API не отдаёт файлы больше 20 МБ.
CLAUDETG_ATTACH_DIR=/home/YOU/Downloads/claudetg
CLAUDETG_ATTACH_MAX_MB=20
