[Unit]
Description=Telegram bot for Claude Code / OpenCode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/claudetg/claudetg.env
ExecStart=%h/.local/bin/claudetg
Restart=on-failure
# Перезапуск бота не убивает начатую задачу агента: сессия claude/opencode
# доживает до конца, а следующий бот подхватывает её по session_id из состояния.
KillMode=process
RestartSec=5

[Install]
WantedBy=default.target
